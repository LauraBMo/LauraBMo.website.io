# Read by .github/workflows/{ci,deploy}.yml. Not used at build time by Hugo itself.

# Hugo version, extended edition. Must match what is installed locally — the build runs
# with --panicOnWarning, so a version skew turns into a build that passes in one place and
# fails in the other. Pin locally with: sudo dnf versionlock add hugo
HUGO_VERSION=0.162.1

# Wrangler version for the deploy step. cloudflare/wrangler-action defaults to 3.90.0,
# which predates assets-only Workers and fails with "Missing entry-point" against a
# wrangler.jsonc that declares no main script.
WRANGLER_VERSION=4.118.0
